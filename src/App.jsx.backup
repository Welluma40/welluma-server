  depression: "https://www.mayoclinic.org/diseases-conditions/depression/symptoms-causes/syc-20356007",
  "heart disease": "https://www.mayoclinic.org/diseases-conditions/heart-disease/symptoms-causes/syc-20353118",
  obesity: "https://www.mayoclinic.org/diseases-conditions/obesity/symptoms-causes/syc-20375742",
  sleep: "https://www.mayoclinic.org/diseases-conditions/insomnia/symptoms-causes/syc-20355167",
  "back pain": "https://www.mayoclinic.org/diseases-conditions/back-pain/symptoms-causes/syc-20369906",
  exercise: "https://www.mayoclinic.org/healthy-lifestyle/fitness/basics/fitness-basics/hlv-20049447",
  nutrition: "https://www.mayoclinic.org/healthy-lifestyle/nutrition-and-healthy-eating/basics/nutrition-basics/hlv-20049477",
  pcos: "https://www.mayoclinic.org/diseases-conditions/pcos/symptoms-causes/syc-20353439",
