import { useState, useRef, useEffect } from "react";
import { supabase } from "./supabase";
import { CapacitorCalendar } from "@ebarooni/capacitor-calendar";
import callClaude from "./callClaude";
import { Purchases, LOG_LEVEL } from "@revenuecat/purchases-capacitor";
import frTranslations from "./translations";

// Language detection
const deviceLang = (navigator.language || navigator.userLanguage || "en").toLowerCase();
const isFrench = deviceLang.startsWith("fr");
const t = isFrench ? frTranslations : null;
const T = (key, fallback) => {
  if (!t) return fallback;
  const keys = key.split(".");
  let val = t;
  for (const k of keys) { val = val?.[k]; }
  return val || fallback;
};

const C = {
  navy: "#0B2D56", navyMid: "#1a3f6f",
  teal: "#0E7C6B", tealLight: "#E8F2EF", tealMid: "#1D9E75",
  blue: "#185FA5", blueLight: "#E6F1FB",
  amber: "#BA7517", amberLight: "#FAEEDA",
  red: "#A32D2D", redLight: "#FCEBEB",
  gray50: "#F8F7F3", gray100: "#F1EFE8", gray200: "#D3D1C7",
  gray400: "#9B9A96", gray600: "#5F5E5A",
  text: "#1a1a1a", white: "#ffffff",
  border: "rgba(0,0,0,0.10)",
};

