# Public service configuration
PORT=3001
CORS_ORIGINS=capacitor://localhost,http://localhost,https://localhost
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=replace-in-app-service

# Secrets: store these in Azure Key Vault and expose them to App Service by
# managed-identity Key Vault references. Never commit real values.
SUPABASE_SERVICE_ROLE_KEY=key-vault-reference
RESEND_API_KEY=key-vault-reference
SRFAX_ACCESS_ID=key-vault-reference
SRFAX_ACCESS_PASSWORD=key-vault-reference
SRFAX_CALLER_ID=key-vault-reference

# Canadian Azure processing
SUMMARY_PROVIDER=azure
REQUIRE_CANADIAN_PROCESSING=true
AZURE_SPEECH_REGION=canadacentral
AZURE_SPEECH_ENDPOINT=https://YOUR_SPEECH_RESOURCE.cognitiveservices.azure.com
AZURE_OPENAI_REGION=canadaeast
AZURE_OPENAI_ENDPOINT=https://aoai-welluma-dev-ce01.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=welluma-summary-gpt41mini

# Production remains false: App Service uses its managed identity.
ALLOW_AZURE_API_KEYS=false
